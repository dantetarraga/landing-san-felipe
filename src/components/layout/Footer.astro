<style>
  .sf-footer {
    background: var(--color-navy);
    color: rgba(255,255,255,.7);
    padding: 80px 0 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 56px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 600;
    color: white;
    text-decoration: none;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }
  .footer-logo-mark {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--color-primary);
    color: white;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .footer-tag {
    max-width: 300px;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(255,255,255,.6);
    margin-top: 0;
  }

  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .footer-social-link {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.7);
    transition: background .2s ease, color .2s ease;
    text-decoration: none;
  }
  .footer-social-link:hover { background: rgba(255,255,255,.14); color: white; }
  .footer-wa { background: rgba(37,211,102,.15); }
  .footer-wa:hover { background: #25d366; color: white; }

  .footer-col-title {
    color: white;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 18px;
    font-family: var(--font-heading);
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-list a {
    font-size: 14px;
    color: rgba(255,255,255,.7);
    text-decoration: none;
    transition: color .2s ease;
  }
  .footer-list a:hover { color: white; }

  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-bottom-links {
    display: flex;
    gap: 24px;
  }
  .footer-bottom-links a {
    color: rgba(255,255,255,.5);
    text-decoration: none;
    transition: color .2s;
  }
  .footer-bottom-links a:hover { color: white; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 36px; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
