<div class="sticky-mobile-cta" role="navigation" aria-label="Acciones rápidas móvil">
  <a href="tel:+51999999999" class="mob-action mob-action-ghost" aria-label="Llamar">
    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
    </svg>
    Llamar
  </a>
  <a href="#reservar" class="mob-action mob-action-primary">
    Reservar cita
    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
  </a>
</div>

<style>
  .sticky-mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    display: none;
    gap: 10px;
    z-index: 55;
    box-shadow: 0 -8px 24px rgba(11,29,51,.08);
  }

  .mob-action {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 14px 16px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background .15s ease;
    font-family: var(--font-heading);
  }

  .mob-action-ghost {
    background: #F3F7F9;
    color: var(--color-navy);
    border: 1px solid var(--color-border);
  }
  .mob-action-ghost:hover { background: #e8eff5; }

  .mob-action-primary {
    background: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 4px 14px -6px rgba(27,63,144,.5);
  }
  .mob-action-primary:hover { background: var(--color-primary-dark); }

  @media (max-width: 720px) {
    .sticky-mobile-cta { display: flex; }
    body { padding-bottom: 80px; }
  }
</style>
