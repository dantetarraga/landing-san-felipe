---
interface Props {
  /** When true the header starts transparent (for pages with a dark fullbleed hero). */
  transparentTop?: boolean;
}
const { transparentTop = false } = Astro.props;
---

<header
  id="navbar"
  class="sf-header"
  data-scrolled="false"
  data-transparent-top={transparentTop ? "true" : "false"}
>
  <div class="container">
    <div class="header-inner">

      <!-- Logo -->
      <a href="/" class="logo" aria-label="Clínica Dental San Felipe — Inicio">
        <span class="logo-mark" aria-hidden="true">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
          </svg>
        </span>
        <span>San Felipe</span>
      </a>

      <!-- Desktop nav -->
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#resultados">Resultados</a>
        <a href="#equipo">Equipo</a>
        <a href="#ubicacion">Ubicación</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <!-- Desktop CTAs -->
      <div class="header-cta">
        <a href="tel:+51999999999" class="header-phone" aria-label="Llamar al +51 999 999 999">
          <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          999 999 999
        </a>
        <a href="#reservar" class="btn-header-accent">
          Chequeo y diagnóstico
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="hamburger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Spacer so page content clears the fixed header -->
<div class="header-spacer" aria-hidden="true"></div>

<!-- Mobile menu — fixed overlay below the header bar -->
<nav id="mobile-menu" class="mobile-menu" hidden aria-label="Menú móvil">
  <div class="mobile-menu-scroll">

    <!-- Nav links -->
    <div class="mob-section">
      <p class="mob-section-label">Navegar</p>
      <a href="#servicios" class="mob-link">
        <span class="mob-link-icon" aria-hidden="true">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        </span>
        <span class="mob-link-text">Servicios</span>
        <svg class="mob-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#resultados" class="mob-link">
        <span class="mob-link-icon" aria-hidden="true">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </span>
        <span class="mob-link-text">Antes &amp; Después</span>
        <svg class="mob-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#equipo" class="mob-link">
        <span class="mob-link-icon" aria-hidden="true">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </span>
        <span class="mob-link-text">Equipo</span>
        <svg class="mob-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#ubicacion" class="mob-link">
        <span class="mob-link-icon" aria-hidden="true">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </span>
        <span class="mob-link-text">Ubicación</span>
        <svg class="mob-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      </a>
      <a href="#contacto" class="mob-link">
        <span class="mob-link-icon" aria-hidden="true">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </span>
        <span class="mob-link-text">Contacto</span>
        <svg class="mob-link-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      </a>
    </div>

    <!-- CTAs -->
    <div class="mob-section mob-section-ctas">
      <p class="mob-section-label">Agenda tu cita</p>

      <a href="#reservar" class="mob-cta mob-cta-diagnose">
        <span class="mob-cta-icon" aria-hidden="true">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </span>
        <span class="mob-cta-body">
          <span class="mob-cta-title">Chequeo y diagnóstico</span>
          <span class="mob-cta-sub">Gratuito · Sin compromiso</span>
        </span>
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>

      <a href="#reservar" class="mob-cta mob-cta-book">
        <span class="mob-cta-icon" aria-hidden="true">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </span>
        <span class="mob-cta-body">
          <span class="mob-cta-title">Reservar cita</span>
          <span class="mob-cta-sub">Espinar y Arequipa</span>
        </span>
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <!-- Contact bottom -->
    <div class="mob-contact">
      <a href="tel:+51999999999" class="mob-phone-link">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        +51 999 999 999
      </a>
      <span class="mob-contact-sep" aria-hidden="true">·</span>
      <span class="mob-contact-hours">Lun–Vie 9:00–19:00</span>
    </div>

  </div>
</nav>

<style>
  /* ── Header shell ───────────────────────────────── */
  .sf-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    transition: background .25s ease, box-shadow .25s ease,
                backdrop-filter .25s ease, border-color .25s ease;
    border-bottom: 1px solid transparent;
    /* Default: always solid (for inner pages) */
    background: rgba(255,255,255,.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 0 rgba(11,29,51,.04);
  }

  /* Transparent mode: only when transparentTop=true AND not yet scrolled */
  .sf-header[data-transparent-top="true"][data-scrolled="false"] {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  /* ── Inner bar height ───────────────────────────── */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 32px;
    transition: height .25s ease;
  }
  .sf-header[data-scrolled="true"] .header-inner { height: 64px; }

  /* ── Logo ───────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 20px;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    flex-shrink: 0;
    text-decoration: none;
    transition: color .2s;
  }
  /* White logo only in transparent mode before scroll */
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .logo { color: white; }

  .logo-mark {
    width: 38px; height: 38px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--color-primary), #5C9BD5);
    color: white;
    display: grid; place-items: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px -4px rgba(27,63,144,.4);
  }

  /* ── Desktop nav ────────────────────────────────── */
  .desktop-nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .desktop-nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-2, var(--color-muted));
    position: relative;
    padding: 6px 0;
    text-decoration: none;
    transition: color .2s;
  }
  /* Default (solid header): dark text */
  .desktop-nav a { color: var(--color-muted); }
  .desktop-nav a:hover { color: var(--color-navy); }

  /* Transparent mode: white text */
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .desktop-nav a {
    color: rgba(255,255,255,.85);
  }
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .desktop-nav a:hover {
    color: white;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .25s ease;
    border-radius: 2px;
  }
  .desktop-nav a:hover::after { transform: scaleX(1); }

  /* ── Header CTAs ────────────────────────────────── */
  .header-cta {
    display: flex; gap: 10px; align-items: center; flex-shrink: 0;
  }

  .header-phone {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 600;
    color: var(--color-navy);
    text-decoration: none; transition: color .2s;
  }
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .header-phone {
    color: rgba(255,255,255,.85);
  }

  .btn-header-accent {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px;
    background: #2ECC71;
    color: white;
    border-radius: 14px;
    font-size: 14px; font-weight: 600;
    text-decoration: none;
    transition: background .2s ease, box-shadow .2s ease;
    box-shadow: 0 4px 14px -6px rgba(46,204,113,.6);
    white-space: nowrap;
  }
  .btn-header-accent:hover { background: #25a85a; }

  /* ── Hamburger ──────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    border-radius: 10px;
    cursor: pointer;
    transition: background .15s;
    background: none; border: none;
  }
  .hamburger:hover { background: rgba(27,63,144,.08); }
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .hamburger:hover {
    background: rgba(255,255,255,.12);
  }

  .ham-line {
    width: 22px; height: 2px;
    border-radius: 2px;
    background: var(--color-navy);
    transition: background .2s, transform .2s;
    display: block;
  }
  .sf-header[data-transparent-top="true"][data-scrolled="false"] .ham-line { background: white; }

  /* Animated X when menu is open */
  .hamburger[aria-expanded="true"] .ham-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .ham-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] .ham-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Spacer ─────────────────────────────────────── */
  .header-spacer { height: 76px; }

  /* ── Mobile menu (fullscreen fixed overlay) ─────── */
  .mobile-menu {
    position: fixed;
    top: 76px;
    left: 0; right: 0; bottom: 0;
    background: #f8fafc;
    z-index: 57; /* above MobileBar(55), below WhatsApp(60) */
    overflow: hidden;
    border-top: 1px solid var(--color-border);
  }
  .mobile-menu[hidden] { display: none; }

  .mobile-menu:not([hidden]) {
    animation: menuSlideIn 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes menuSlideIn {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mobile-menu-scroll {
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 16px 16px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Section wrapper ────────────────────────────── */
  .mob-section {
    background: white;
    border-radius: 18px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(11,29,51,.04);
  }

  .mob-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 12px 16px 6px;
    margin: 0;
  }

  /* ── Nav links ──────────────────────────────────── */
  .mob-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-navy);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    transition: background .15s;
  }
  .mob-link:first-of-type { border-top: none; }
  .mob-link:active { background: #f0f4f8; }

  .mob-link-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: #e7f0fa;
    color: var(--color-primary);
    display: grid; place-items: center;
    flex-shrink: 0;
  }

  .mob-link-text { flex: 1; }

  .mob-link-arrow {
    color: var(--color-muted);
    flex-shrink: 0;
    transition: transform .2s;
  }
  .mob-link:active .mob-link-arrow { transform: translateX(4px); }

  /* ── CTA cards ──────────────────────────────────── */
  .mob-section-ctas {
    border: none;
    background: transparent;
    box-shadow: none;
    overflow: visible;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mob-cta {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 16px;
    text-decoration: none;
    transition: transform .15s, box-shadow .15s;
    border: 1px solid transparent;
  }
  .mob-cta:active { transform: scale(0.98); }

  .mob-cta-diagnose {
    background: linear-gradient(135deg, #2ECC71, #25a85a);
    color: white;
    box-shadow: 0 6px 20px -6px rgba(46,204,113,.55);
  }
  .mob-cta-diagnose:active { box-shadow: 0 2px 8px -4px rgba(46,204,113,.4); }

  .mob-cta-book {
    background: linear-gradient(135deg, var(--color-primary), #1a3578);
    color: white;
    box-shadow: 0 6px 20px -6px rgba(27,63,144,.5);
  }
  .mob-cta-book:active { box-shadow: 0 2px 8px -4px rgba(27,63,144,.4); }

  .mob-cta-icon {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: rgba(255,255,255,.2);
    display: grid; place-items: center;
    flex-shrink: 0;
  }

  .mob-cta-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mob-cta-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }
  .mob-cta-sub {
    font-size: 12px;
    opacity: .8;
    font-weight: 400;
  }

  /* ── Bottom contact strip ───────────────────────── */
  .mob-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 0 4px;
    font-size: 13px;
    color: var(--color-muted);
    flex-wrap: wrap;
  }
  .mob-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }
  .mob-contact-sep { color: var(--color-border); }
  .mob-contact-hours { font-size: 12px; }

  /* ── Responsive breakpoints ─────────────────────── */
  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .header-phone { display: none; }
    .hamburger { display: flex; }
    .btn-header-accent { display: none; }
  }

  /* When mobile menu is open, header height may be 64px (scrolled) */
  /* Adjust top of overlay accordingly */
  @media (max-width: 900px) {
    .mobile-menu { top: 76px; }
  }
</style>

<script>
  const header = document.getElementById("navbar")!;
  const btn = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;

  // ── Scroll detection ─────────────────────────────
  function onScroll() {
    const scrolled = window.scrollY > 24;
    header.dataset.scrolled = scrolled ? "true" : "false";
    // Keep mobile menu top in sync with header height
    menu.style.top = scrolled ? "64px" : "76px";
  }
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Mobile menu toggle ────────────────────────────
  function openMenu() {
    menu.hidden = false;
    btn.setAttribute("aria-expanded", "true");
    btn.setAttribute("aria-label", "Cerrar menú");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu.hidden = true;
    btn.setAttribute("aria-expanded", "false");
    btn.setAttribute("aria-label", "Abrir menú");
    document.body.style.overflow = "";
  }

  btn.addEventListener("click", () => {
    menu.hidden ? openMenu() : closeMenu();
  });

  // Close on link click
  menu.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", closeMenu);
  });

  // Close on resize to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) closeMenu();
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      closeMenu();
      btn.focus();
    }
  });
</script>
