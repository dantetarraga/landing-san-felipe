---
import SectionHeader from "../ui/SectionHeader.astro";

const cases = [
  { name: "María C.", treatment: "Diseño de sonrisa con carillas" },
  { name: "Roberto V.", treatment: "Ortodoncia + blanqueamiento (18 meses)" },
  { name: "Ana L.", treatment: "Implantes superiores + corona" },
];
---

<section class="section-pad ba-section" id="resultados" aria-label="Antes y después">
  <div class="container">

    <SectionHeader
      eyebrow="Antes & Después"
      title="Resultados reales de pacientes reales."
      body="Arrastra el control para ver la transformación. Todos los casos cuentan con el consentimiento de nuestros pacientes."
    />

    <div class="ba-grid">
      {cases.map((c) => (
        <div class="ba-card">
          <div class="ba-slider" role="img" aria-label={`Antes y después: ${c.name} — ${c.treatment}`}>
            <div class="ba-img ba-before">
              <div class="ba-ph ba-ph-before">
                <span class="ba-ph-tag">ANTES</span>
                <span class="ba-ph-icon" aria-hidden="true">🦷</span>
                <span class="ba-ph-caption">Foto real del paciente antes del tratamiento</span>
              </div>
            </div>
            <div class="ba-img ba-after">
              <div class="ba-ph ba-ph-after">
                <span class="ba-ph-tag ba-ph-tag--after">DESPUÉS</span>
                <span class="ba-ph-icon" aria-hidden="true">😁</span>
                <span class="ba-ph-caption">Foto real del resultado final</span>
              </div>
            </div>
            <span class="ba-label ba-label-before">Antes</span>
            <span class="ba-label ba-label-after">Después</span>
            <div class="ba-handle" aria-hidden="true"></div>
          </div>
          <div class="ba-meta">
            <div>
              <div class="ba-name">{c.name}</div>
              <div class="ba-treatment">{c.treatment}</div>
            </div>
            <span style="color:#2ECC71;font-size:20px;" aria-hidden="true">✨</span>
          </div>
        </div>
      ))}
    </div>

    <p class="ba-disclaimer">* Los resultados varían según cada paciente. Te ofreceremos un plan personalizado en tu primera consulta.</p>
  </div>
</section>

<style>
  .ba-section { background: #ffffff; }

  .ba-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .ba-card { border-radius: 14px; overflow: hidden; border: 1px solid var(--color-border); }

  .ba-slider {
    position: relative; aspect-ratio: 4/3;
    user-select: none; touch-action: none;
    cursor: ew-resize; overflow: hidden;
  }

  .ba-img { position: absolute; inset: 0; }
  .ba-after { clip-path: inset(0 0 0 50%); }

  .ba-ph {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #e7f0fa, #F3F7F9);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 8px;
    position: relative;
  }
  .ba-ph-after { background: linear-gradient(135deg, #e0f8ea, #F3F7F9); }

  .ba-ph-tag {
    position: absolute; top: 10px; left: 10px;
    background: rgba(11,29,51,.85); color: white;
    font-size: 9px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 8px; border-radius: 4px;
  }
  .ba-ph-tag--after { background: #2ECC71; }

  .ba-ph-icon { font-size: 40px; opacity: .35; }
  .ba-ph-caption { font-size: 11px; color: rgba(11,29,51,.45); text-align: center; padding: 0 16px; }

  .ba-label {
    position: absolute; bottom: 12px;
    padding: 4px 10px;
    background: rgba(11,29,51,.85); color: white;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: 4px; z-index: 3; pointer-events: none;
  }
  .ba-label-before { left: 12px; }
  .ba-label-after { right: 12px; background: #2ECC71; }

  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: 50%;
    width: 2px; background: white;
    box-shadow: 0 0 0 1px rgba(11,29,51,.18);
    pointer-events: none; z-index: 4;
  }
  .ba-handle::after {
    content: '⇆';
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 40px; height: 40px; border-radius: 999px;
    background: white; box-shadow: 0 4px 12px rgba(11,29,51,.25);
    display: grid; place-items: center;
    font-size: 16px; color: var(--color-navy); z-index: 5;
  }

  .ba-meta {
    padding: 16px 18px;
    display: flex; justify-content: space-between; align-items: center;
    background: #ffffff;
  }
  .ba-name { font-weight: 600; font-size: 15px; color: var(--color-navy); }
  .ba-treatment { font-size: 13px; color: var(--color-muted); margin-top: 2px; }

  .ba-disclaimer { margin-top: 32px; font-size: 13px; color: var(--color-muted); text-align: center; }

  @media (max-width: 900px) { .ba-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".ba-slider").forEach((slider) => {
    const after = slider.querySelector<HTMLElement>(".ba-after");
    const handle = slider.querySelector<HTMLElement>(".ba-handle");
    let dragging = false;

    function setPos(clientX: number) {
      const rect = slider.getBoundingClientRect();
      const x = Math.max(2, Math.min(98, ((clientX - rect.left) / rect.width) * 100));
      if (after) after.style.clipPath = `inset(0 0 0 ${x}%)`;
      if (handle) handle.style.left = `${x}%`;
    }

    slider.addEventListener("pointerdown", (e) => {
      dragging = true;
      setPos(e.clientX);
      slider.setPointerCapture(e.pointerId);
    });
    slider.addEventListener("pointermove", (e) => { if (dragging) setPos(e.clientX); });
    slider.addEventListener("pointerup", () => { dragging = false; });
  });
</script>
