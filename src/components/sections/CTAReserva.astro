---
---

<section class="booking-section section-pad" id="reservar" aria-label="Reserva tu cita">
  <div class="container">
    <div class="booking-grid">

      <!-- Left: copy -->
      <div class="booking-copy">
        <span class="booking-eyebrow">Reservar cita</span>
        <h2>Tu próxima sonrisa empieza con un mensaje.</h2>
        <p>Completa tres datos y te llamamos en menos de 30 minutos para coordinar tu cita en el horario que mejor te quede.</p>

        <ul class="booking-points">
          <li class="booking-point">
            <span class="bp-check">✓</span>
            Primera evaluación sin costo
          </li>
          <li class="booking-point">
            <span class="bp-check">✓</span>
            Plan de tratamiento por escrito
          </li>
          <li class="booking-point">
            <span class="bp-check">✓</span>
            Financiamiento sin intereses disponible
          </li>
          <li class="booking-point">
            <span class="bp-check">✓</span>
            Te respondemos en menos de 30 min
          </li>
        </ul>
      </div>

      <!-- Right: form -->
      <div class="booking-form-wrap">
        <h3>Reserva en 30 segundos</h3>
        <p class="booking-form-sub">Te contactamos para confirmar la cita.</p>

        <div id="booking-success" class="booking-success" hidden role="alert" aria-live="polite">
          <span class="bs-icon">✓</span>
          <div>
            <div style="font-weight:700;margin-bottom:2px;">¡Recibimos tu solicitud!</div>
            <span id="booking-success-phone"></span>
          </div>
        </div>

        <form id="booking-form" novalidate>
          <div class="bfield">
            <label for="b-name">Tu nombre</label>
            <input type="text" id="b-name" name="name" placeholder="María Pérez" autocomplete="name" required />
          </div>
          <div class="bfield">
            <label for="b-phone">Teléfono / WhatsApp</label>
            <input type="tel" id="b-phone" name="phone" placeholder="+51 999 000 000" autocomplete="tel" required />
          </div>
          <div class="bfield">
            <label for="b-service">¿Qué te gustaría tratar?</label>
            <select id="b-service" name="service" required>
              <option value="">Elige un servicio</option>
              <option>Chequeo y diagnóstico</option>
              <option>Limpieza dental</option>
              <option>Ortodoncia / Brackets</option>
              <option>Implantes dentales</option>
              <option>Diseño de sonrisa</option>
              <option>Endodoncia</option>
              <option>Atención para niños</option>
              <option>Otro / consulta general</option>
            </select>
          </div>
          <button type="submit" class="btn-submit">
            Solicitar mi cita
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </button>
          <p class="booking-legal">Al enviar aceptas que te contactemos por teléfono o WhatsApp.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .booking-section {
    background: var(--color-primary);
    color: white;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 64px;
    align-items: center;
  }

  /* Left copy */
  .booking-copy h2 {
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: white;
    line-height: 1.1;
    margin-top: 14px;
  }
  .booking-copy p {
    color: rgba(255,255,255,.78);
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.55;
  }

  .booking-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5C9BD5;
  }
  .booking-eyebrow::before {
    content: '';
    width: 18px;
    height: 1px;
    background: #5C9BD5;
    display: inline-block;
  }

  .booking-points {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    padding: 0;
  }
  .booking-point {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: rgba(255,255,255,.9);
  }
  .bp-check {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: rgba(46,204,113,.25);
    color: #2ECC71;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Right form */
  .booking-form-wrap {
    background: #ffffff;
    border-radius: 22px;
    padding: 36px;
    color: var(--color-navy);
    box-shadow: 0 30px 60px -20px rgba(11,29,51,.35);
  }
  .booking-form-wrap h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    margin-bottom: 6px;
  }
  .booking-form-sub {
    color: var(--color-muted);
    font-size: 14px;
    margin-bottom: 24px;
  }

  .booking-success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #16a34a;
    padding: 16px;
    border-radius: 10px;
    font-size: 14px;
    margin-bottom: 18px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .booking-success[hidden] { display: none; }
  .bs-icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: #2ECC71;
    color: white;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .bfield { margin-bottom: 18px; }
  .bfield label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--color-muted);
  }
  .bfield input,
  .bfield select {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    background: #ffffff;
    color: var(--color-navy);
    transition: border-color .15s ease, box-shadow .15s ease;
    outline: none;
  }
  .bfield input:focus-visible,
  .bfield select:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(27,63,144,.12);
  }
  .bfield input[aria-invalid="true"],
  .bfield select[aria-invalid="true"] {
    border-color: #c2410c;
    box-shadow: 0 0 0 3px rgba(194,65,12,.1);
  }

  .btn-submit {
    width: 100%;
    padding: 16px;
    background: #2ECC71;
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background .2s ease, box-shadow .2s ease;
    box-shadow: 0 8px 22px -10px rgba(46,204,113,.55);
  }
  .btn-submit:hover { background: #25a85a; }
  .btn-submit:active { transform: translateY(1px); }

  .booking-legal {
    font-size: 12px;
    color: var(--color-muted);
    margin-top: 14px;
    text-align: center;
  }

  @media (max-width: 980px) {
    .booking-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 560px) {
    .booking-form-wrap { padding: 24px; }
  }
</style>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement;
  const successEl = document.getElementById("booking-success")!;
  const successPhone = document.getElementById("booking-success-phone")!;
  const inputs = form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input[required], select[required]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    let valid = true;
    let firstInvalid: HTMLElement | null = null;
    inputs?.forEach((el) => {
      if (!el.value.trim()) {
        el.setAttribute("aria-invalid", "true");
        if (!firstInvalid) firstInvalid = el;
        valid = false;
      } else {
        el.setAttribute("aria-invalid", "false");
      }
    });
    if (!valid) { firstInvalid?.focus(); return; }

    const name = (form.elements.namedItem("name") as HTMLInputElement).value;
    const phone = (form.elements.namedItem("phone") as HTMLInputElement).value;
    const service = (form.elements.namedItem("service") as HTMLSelectElement).value;

    successPhone.textContent = `Te contactaremos al ${phone} muy pronto.`;
    successEl.hidden = false;
    form.hidden = true;

    const msg = encodeURIComponent(`Hola! Me llamo ${name} y quiero reservar una cita.\n🦷 Servicio: ${service}\n📞 Tel: ${phone}`);
    setTimeout(() => window.open(`https://wa.me/51999999999?text=${msg}`, "_blank", "noopener"), 800);
  });

  inputs?.forEach((el) => {
    el.addEventListener("input", () => el.setAttribute("aria-invalid", "false"));
  });
</script>
