---
import SectionHeader from "../ui/SectionHeader.astro";
import { services } from "../../data/services";

// Map services data to what we need for this section
const items = services.map((s) => ({
  id: s.slug,
  icon: s.icon,
  title: s.name,
  short: s.description,
  long: s.tagline,
  includes: s.benefits.slice(0, 4),
  featured: s.slug === "implantes-dentales",
}));
---

<section class="section-pad" id="servicios" aria-label="Nuestros servicios">
  <div class="container">

    <SectionHeader
      eyebrow="Servicios"
      title="Cuidado dental completo, en un solo lugar."
      body="Desde la primera limpieza hasta el diseño completo de sonrisa. Todos nuestros tratamientos los realizan especialistas certificados con tecnología actualizada."
      row
    >
      <a href="#reservar" class="header-link">
        Ver todos los planes
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </SectionHeader>

    <div class="services-grid">
      {items.map((s) => (
        <button
          class:list={["service-card", { featured: s.featured }]}
          data-service={s.id}
          aria-label={`Ver detalles de ${s.title}`}
        >
          <div class="service-icon">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.short}</p>
          <span class="service-arrow">
            Ver detalles
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Service detail modal -->
<div class="modal-backdrop" id="service-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
  <div class="modal">
    <button class="modal-close" id="modal-close" aria-label="Cerrar">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="modal-icon" id="modal-icon"></div>
    <h3 id="modal-title"></h3>
    <p id="modal-long" style="color:var(--color-muted);font-size:16px;line-height:1.55;"></p>
    <h4 class="modal-includes-label">Incluye</h4>
    <div id="modal-includes"></div>
    <div class="modal-actions">
      <a href="#reservar" class="btn btn-primary modal-cta" id="modal-book">Reservar este servicio</a>
      <a href="#reservar" class="btn btn-ghost">Tengo preguntas</a>
    </div>
  </div>
</div>

<style>
  .header-link {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--color-primary); font-weight: 600; font-size: 14px;
    white-space: nowrap; transition: gap .2s ease; flex-shrink: 0;
    text-decoration: none;
  }
  .header-link:hover { gap: 10px; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 28px;
    cursor: pointer;
    display: flex; flex-direction: column; gap: 14px;
    text-align: left; min-height: 220px;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease,
                background .25s ease, color .25s ease;
    font-family: inherit;
  }
  .service-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px -8px rgba(27,63,144,.14); border-color: #d4dde6; }

  .service-icon { font-size: 24px; width: 48px; height: 48px; border-radius: 14px; background: #e7f0fa; display: grid; place-items: center; }

  .service-card h3 { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-navy); line-height: 1.2; }
  .service-card p { color: var(--color-muted); font-size: 14.5px; line-height: 1.5; flex: 1; }

  .service-arrow {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--color-primary); font-size: 13px; font-weight: 600;
    margin-top: auto; transition: gap .2s ease;
  }
  .service-card:hover .service-arrow { gap: 12px; }

  .service-card.featured { background: var(--color-primary); border-color: var(--color-primary); }
  .service-card.featured h3,
  .service-card.featured p { color: white; }
  .service-card.featured .service-icon { background: rgba(255,255,255,.14); }
  .service-card.featured .service-arrow { color: #2ECC71; }

  /* Modal */
  .modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(11,29,51,.45); backdrop-filter: blur(6px);
    display: grid; place-items: center;
    z-index: 100; padding: 24px;
    animation: fadeIn .2s ease;
  }
  .modal-backdrop[hidden] { display: none; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .modal {
    background: #ffffff; border-radius: 22px;
    max-width: 640px; width: 100%; padding: 40px;
    position: relative;
    box-shadow: 0 30px 60px -20px rgba(27,63,144,.22);
    animation: slideUp .3s cubic-bezier(.2,.8,.2,1);
    max-height: 85vh; overflow-y: auto;
  }
  @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .modal-close {
    position: absolute; top: 16px; right: 16px;
    width: 36px; height: 36px; border-radius: 999px;
    background: #F3F7F9; display: grid; place-items: center;
    cursor: pointer; transition: background .15s;
    border: none;
  }
  .modal-close:hover { background: #e1e9f0; }

  .modal-icon {
    font-size: 28px; width: 56px; height: 56px;
    border-radius: 14px; background: #e7f0fa;
    display: grid; place-items: center; margin-bottom: 18px;
  }

  .modal h3 { font-size: 28px; font-weight: 700; letter-spacing: -0.025em; color: var(--color-navy); margin-bottom: 12px; }

  .modal-includes-label {
    font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-muted); margin: 24px 0 8px;
  }

  .modal-feature {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 0; border-bottom: 1px solid var(--color-border);
    font-size: 14.5px; color: var(--color-navy);
  }
  .modal-feature:last-child { border-bottom: 0; }
  .modal-check {
    width: 20px; height: 20px; border-radius: 999px;
    background: #e0f8ea; color: #2ECC71;
    display: grid; place-items: center;
    flex-shrink: 0; margin-top: 1px;
    font-size: 11px; font-weight: 700;
  }

  .modal-actions { display: flex; gap: 10px; margin-top: 28px; }
  .modal-cta { flex: 1; }

  @media (max-width: 980px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .services-grid { grid-template-columns: 1fr; }
    .modal { padding: 24px; }
    .modal-actions { flex-direction: column; }
  }
</style>

<script>
  // Build a lookup from services data
  const DATA: Record<string, { icon: string; title: string; long: string; includes: string[] }> = {};

  document.querySelectorAll<HTMLButtonElement>(".service-card[data-service]").forEach((btn) => {
    const id = btn.dataset.service!;
    const icon = btn.querySelector(".service-icon")?.textContent?.trim() ?? "";
    const title = btn.querySelector("h3")?.textContent?.trim() ?? "";
    const desc = btn.querySelector("p")?.textContent?.trim() ?? "";
    DATA[id] = { icon, title, long: desc, includes: [] };
  });

  const INCLUDES: Record<string, string[]> = {
    "limpieza-dental": ["Revisión completa", "Eliminación de sarro con ultrasonido", "Pulido y flúor", "Plan de higiene personalizado"],
    "extracciones-dentales": ["Anestesia indolora", "Sedación consciente disponible", "Sutura y cuidados post-op", "Seguimiento incluido"],
    "endodoncia": ["Diagnóstico con radiografía digital", "Una sola sesión en muchos casos", "Sin dolor durante el procedimiento", "Garantía del tratamiento"],
    "protesis-dental": ["Diseño 3D digital", "Materiales premium (zirconio / e.max)", "Pruebas hasta encontrar el calce ideal", "Garantía 5 años"],
    "implantes-dentales": ["Planificación 3D / TAC", "Implantes con garantía de por vida", "Carga inmediata cuando es posible", "Seguimiento post-op completo"],
    "ortodoncia": ["Brackets convencionales y estéticos", "Alineadores invisibles", "Plan de pagos sin intereses", "Controles mensuales incluidos"],
    "odontologia-pediatrica": ["Especialistas en odontopediatría", "Sala de espera infantil", "Selladores y flúor preventivos", "Educación en higiene"],
    "extraccion-muelas-juicio": ["Evaluación con panorámica", "Cirugía con sedación opcional", "Kit post-operatorio incluido", "Control a las 48h y 7 días"],
    "diseno-de-sonrisa": ["Mock-up digital previo", "Carillas de porcelana o composite", "Blanqueamiento profesional", "Resultado garantizado"],
  };

  const backdrop = document.getElementById("service-modal")!;
  const modalEl = backdrop.querySelector<HTMLElement>(".modal")!;
  const modalIcon = document.getElementById("modal-icon")!;
  const modalTitle = document.getElementById("modal-title")!;
  const modalLong = document.getElementById("modal-long")!;
  const modalIncludes = document.getElementById("modal-includes")!;

  const FOCUSABLE = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
  let lastTrigger: HTMLElement | null = null;
  const allCards = Array.from(document.querySelectorAll<HTMLButtonElement>(".service-card[data-service]"));

  function setActive(card: HTMLElement) {
    allCards.forEach((c) => c.classList.remove("featured"));
    card.classList.add("featured");
  }

  function trapFocus(e: KeyboardEvent) {
    const focusable = Array.from(modalEl.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => !el.hasAttribute("disabled")
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.key === "Tab") {
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }
  }

  function openModal(id: string, trigger: HTMLElement) {
    const d = DATA[id];
    if (!d) return;
    lastTrigger = trigger;
    setActive(trigger);
    modalIcon.textContent = d.icon;
    modalTitle.textContent = d.title;
    modalLong.textContent = d.long;
    const incs = INCLUDES[id] ?? [];
    modalIncludes.innerHTML = incs.map((item) =>
      `<div class="modal-feature"><span class="modal-check" aria-hidden="true">✓</span><span>${item}</span></div>`
    ).join("");
    backdrop.hidden = false;
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => {
      document.getElementById("modal-close")?.focus();
    });
    modalEl.addEventListener("keydown", trapFocus);
  }

  function closeModal() {
    backdrop.hidden = true;
    document.body.style.overflow = "";
    modalEl.removeEventListener("keydown", trapFocus);
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.querySelectorAll<HTMLButtonElement>(".service-card[data-service]").forEach((btn) => {
    btn.addEventListener("click", () => openModal(btn.dataset.service!, btn));
  });

  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  backdrop.addEventListener("click", (e) => { if (e.target === backdrop) closeModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !backdrop.hidden) closeModal(); });
  backdrop.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeModal));
</script>
