---
const items = [
  { label: "Esterilización certificada", icon: "shield" },
  { label: "Atención sin dolor", icon: "heart" },
  { label: "Citas el mismo día", icon: "clock" },
  { label: "Tecnología digital", icon: "sparkles" },
  { label: "Pacientes desde los 3 años", icon: "smile" },
];

const icons: Record<string, string> = {
  shield: `<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  heart: `<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.53L12 21.35z"/></svg>`,
  clock: `<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  sparkles: `<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
  smile: `<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
};
---

<div class="trustbar" aria-label="Indicadores de confianza">
  <div class="container">
    <div class="trustbar-inner">
      {items.map((item) => (
        <div class="trustbar-item">
          <span class="trustbar-icon" set:html={icons[item.icon]} />
          {item.label}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .trustbar {
    padding: 28px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: #ffffff;
  }
  .trustbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .trustbar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-navy);
    font-weight: 500;
    white-space: nowrap;
  }
  .trustbar-icon {
    color: var(--color-accent);
    display: flex;
    flex-shrink: 0;
  }
  @media (max-width: 900px) {
    .trustbar-inner {
      justify-content: flex-start;
      gap: 16px 28px;
    }
  }
</style>
