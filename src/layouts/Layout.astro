---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppButton from "../components/layout/WhatsAppButton.astro";
import MobileBar from "../components/layout/MobileBar.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  schema?: object;
}

const {
  title,
  description,
  ogImage = "/og-default.png",
  canonical,
  schema,
} = Astro.props;

const siteUrl = "https://clinicasanfelipe.pe";
const fullTitle = title.includes("San Felipe")
  ? title
  : `${title} | Clínica Dental San Felipe`;
const canonicalUrl = canonical || siteUrl + Astro.url.pathname;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "Clínica Dental San Felipe",
  description:
    "Clínica dental en Espinar y Arequipa. Limpieza, implantes, ortodoncia, endodoncia y más.",
  url: siteUrl,
  telephone: "+51999999999",
  priceRange: "$$",
  address: [
    {
      "@type": "PostalAddress",
      streetAddress: "Calle Anta 107",
      addressLocality: "Espinar",
      addressRegion: "Cusco",
      addressCountry: "PE",
    },
    {
      "@type": "PostalAddress",
      streetAddress: "Calle Marañón 301",
      addressLocality: "Arequipa",
      addressRegion: "Arequipa",
      addressCountry: "PE",
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "14:00",
    },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "127",
  },
  medicalSpecialty: "Dentistry",
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1B3F90" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Clínica Dental San Felipe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Preconnect + Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Navbar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <MobileBar />
  </body>
</html>
