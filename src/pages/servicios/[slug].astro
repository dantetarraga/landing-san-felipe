---
import Layout from "../../layouts/Layout.astro";
import { services, getServiceBySlug } from "../../data/services";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug as string);

if (!service) {
  return Astro.redirect("/servicios");
}

const siteUrl = "https://clinicasanfelipe.pe";

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalProcedure",
      name: service.name,
      description: service.description,
      procedureType: "Dental",
      followUp: "Seguimiento post-tratamiento incluido",
      performer: {
        "@type": "Dentist",
        name: "Clínica Dental San Felipe",
        url: siteUrl,
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Servicios", item: `${siteUrl}/servicios` },
        { "@type": "ListItem", position: 3, name: service.name, item: `${siteUrl}/servicios/${service.slug}` },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: service.faq.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
  ],
};

const otherServices = services.filter((s) => s.slug !== slug).slice(0, 3);
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  schema={serviceSchema}
>
  <!-- Hero -->
  <section class="relative py-16 md:py-24 overflow-hidden" style="background: linear-gradient(135deg, #1B3F90 0%, #152f6b 100%);">
    <div class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 50px 50px;"
      aria-hidden="true"></div>

    <div class="container relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-8" style="color: rgba(255,255,255,0.6);" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <a href="/servicios" class="hover:text-white transition-colors">Servicios</a>
        <span>/</span>
        <span class="text-white">{service.name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-white">
          <div class="text-5xl mb-4" aria-hidden="true">{service.icon}</div>
          <h1 class="font-heading font-extrabold mb-4 text-white leading-tight"
            style="font-size: clamp(1.875rem, 4.5vw, 3rem);">
            {service.heroHeading}
          </h1>
          <p class="text-lg mb-8 leading-relaxed" style="color: rgba(255,255,255,0.82);">
            {service.heroSubtitle}
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/cita" class="btn btn-primary">
              📅 {service.ctaText}
            </a>
            <a href="tel:+51999999999" class="btn btn-outline-white">
              📞 Llamar ahora
            </a>
          </div>
        </div>

        <!-- Benefits card -->
        <div class="bg-white/10 backdrop-blur rounded-2xl p-6 border border-white/20">
          <h2 class="font-heading font-bold text-white mb-4">¿Qué incluye?</h2>
          <ul class="space-y-3">
            {service.benefits.map((benefit) => (
              <li class="flex items-start gap-3 text-sm" style="color: rgba(255,255,255,0.85);">
                <span class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 text-xs font-bold mt-0.5"
                  style="background: var(--color-accent); color: var(--color-navy);">✓</span>
                {benefit}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section-pad" style="background: var(--color-surface);">
    <div class="container max-w-4xl">
      <div class="text-center mb-12">
        <span class="section-eyebrow">Proceso</span>
        <h2 class="section-title text-center">¿Cómo es el procedimiento?</h2>
        <p class="section-subtitle mx-auto text-center mt-3">
          Te lo explicamos paso a paso para que no haya sorpresas.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {service.process.map((p) => (
          <div class="bg-white rounded-2xl p-5 border" style="border-color: var(--color-border);">
            <div class="text-3xl font-extrabold font-heading mb-3" style="color: var(--color-accent);">{p.step}</div>
            <h3 class="font-heading font-bold text-sm mb-2" style="color: var(--color-navy);">{p.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-muted);">{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-pad">
    <div class="container max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="section-title text-center">Preguntas frecuentes sobre {service.name}</h2>
      </div>
      <div class="space-y-3">
        {service.faq.map((faq, i) => (
          <div class="bg-white rounded-2xl border overflow-hidden" style="border-color: var(--color-border);">
            <button
              class="service-faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 text-left"
              data-index={`s-${i}`}
              type="button"
              aria-expanded="false"
            >
              <span class="font-heading font-semibold text-sm md:text-base" style="color: var(--color-navy);">
                {faq.question}
              </span>
              <span class="service-faq-icon shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white text-sm font-bold"
                style="background: var(--color-primary);">+</span>
            </button>
            <div class="accordion-content px-6" id={`service-faq-${i}`}>
              <p class="pb-5 text-sm leading-relaxed" style="color: var(--color-muted);">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-pad" style="background: var(--color-surface);">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="section-title text-center mb-4">
          ¿Listo para empezar?
        </h2>
        <p class="section-subtitle mx-auto text-center mb-8">
          Agenda tu cita o pide tu chequeo gratis. Estamos en Espinar y Arequipa.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/cita" class="btn btn-primary">
            📅 {service.ctaText}
          </a>
          <a href="/chequeo-y-diagnostico" class="btn btn-outline-primary">
            🦷 Diagnóstico gratis
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="section-pad">
    <div class="container">
      <h2 class="section-title text-center mb-8">Otros tratamientos</h2>
      <div class="grid md:grid-cols-3 gap-5">
        {otherServices.map((s) => (
          <a href={`/servicios/${s.slug}`} class="card p-6 group flex flex-col">
            <div class="text-3xl mb-3">{s.icon}</div>
            <h3 class="font-heading font-bold text-base mb-2" style="color: var(--color-navy);">{s.name}</h3>
            <p class="text-sm flex-1 mb-3" style="color: var(--color-muted);">{s.tagline}</p>
            <span class="text-sm font-semibold" style="color: var(--color-primary); font-family: var(--font-heading);">
              Ver más →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll(".service-faq-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const btn = trigger as HTMLButtonElement;
      const index = btn.getAttribute("data-index")?.replace("s-", "");
      const content = document.getElementById(`service-faq-${index}`);
      const icon = btn.querySelector(".service-faq-icon") as HTMLElement;
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      document.querySelectorAll(".service-faq-trigger").forEach((t) => {
        const b = t as HTMLButtonElement;
        const idx = b.getAttribute("data-index")?.replace("s-", "");
        const c = document.getElementById(`service-faq-${idx}`);
        const ic = b.querySelector(".service-faq-icon") as HTMLElement;
        b.setAttribute("aria-expanded", "false");
        c?.classList.remove("open");
        if (ic) { ic.textContent = "+"; ic.style.background = "var(--color-primary)"; }
      });

      if (!isOpen) {
        btn.setAttribute("aria-expanded", "true");
        content?.classList.add("open");
        if (icon) { icon.textContent = "–"; icon.style.background = "var(--color-accent-dark)"; }
      }
    });
  });
</script>
